# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/auth/callback
FRONTEND_URL=http://localhost:5173

# API Keys
GOOGLE_API_KEY=
VOYAGE_API_KEY=

# Azure OpenAI (required only when using azure/* models, e.g. azure/o4-mini)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=          # https://<resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Embedding & Chunking
EMBEDDING_MODEL=gemini
CHUNKING_STRATEGY=tree-sitter-limited

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=tfg
POSTGRES_PASSWORD=tfg_password
POSTGRES_DB=tfg_validator

# Server
API_HOST=0.0.0.0
API_PORT=8080

# Rules
MAX_RULES_PER_REPO=10

# Similarity Search
SIMILARITY_THRESHOLD=0.3
MAX_RESULTS=5
MAX_FILE_CONTENT_SIZE=10000

# Rate Limiting (embedding)
BATCH_SIZE=5
DELAY_BETWEEN_BATCHES=4.0
EMBEDDING_RPM=0
LLM_RPM=0

# Rate Limiting (API) — format: count/period (e.g. 10/minute, 100/hour)
RATE_LIMIT_VALIDATE=10/minute
RATE_LIMIT_DEFAULT=100/minute

# LLM Evaluation
LLM_MODEL=gemini-2.5-flash
LLM_MAX_CONTEXT_TOKENS=900000
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=35.0

# Cross-Check (dual-model evaluation — controlled per request via ?cross_check=true/false)
LLM_PRIMARY_MODEL=gemini-2.5-flash              # first independent evaluator
LLM_SECONDARY_MODEL=gemini-3.1-flash-lite-preview  # second independent evaluator
LLM_DISCRIMINATOR_MODEL=azure/gpt-4o            # breaks ties when primary and secondary disagree
LANGSMITH_DISCRIMINATOR_PROMPT=cross-check-discriminator  # prompt name in LangSmith Hub

# Git Clone Retry (transient network/TLS errors)
CLONE_MAX_RETRIES=3
CLONE_RETRY_DELAY=5.0

# Background Worker
WORKER_POLL_INTERVAL=2

# GitHub App (bot identity + automatic webhooks)
GITHUB_APP_ID=                   # numeric App ID shown in app settings
GITHUB_APP_PRIVATE_KEY_PATH=     # path inside the container, e.g. /app/secrets/tfg-validator.pem
GITHUB_APP_SLUG=                 # URL slug of the app, e.g. "rule-validator-tfg"
GITHUB_WEBHOOK_SECRET=           
APPROVAL_THRESHOLD=0.8           # score >= threshold → PR approved

# LangSmith
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # usar https://eu.api.smith.langchain.com para cuentas EU
LANGSMITH_PROJECT=TFG
LANGSMITH_TRACING=false

# ngrok (tunnel for local webhook delivery)
NGROK_AUTHTOKEN=
