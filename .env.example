# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/auth/callback
FRONTEND_URL=http://localhost:5173

# API Keys
GOOGLE_API_KEY=
VOYAGE_API_KEY=

# Embedding & Chunking
EMBEDDING_MODEL=gemini
CHUNKING_STRATEGY=tree-sitter-limited

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=tfg
POSTGRES_PASSWORD=tfg_password
POSTGRES_DB=tfg_validator

# Rules
MAX_RULES_PER_REPO=10

# Similarity Search
SIMILARITY_THRESHOLD=0.3
MAX_RESULTS=5
MAX_FILE_CONTENT_SIZE=10000

# Rate Limiting
BATCH_SIZE=5
DELAY_BETWEEN_BATCHES=4.0
EMBEDDING_RPM=0

# LLM Evaluation
LLM_MODEL=gemini-2.5-flash
LLM_MAX_CONTEXT_TOKENS=900000
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=35.0

# Cross-Check (dual-model evaluation — controlled per request via ?cross_check=true/false)
ENABLE_CROSS_CHECK=true
LLM_PRIMARY_MODEL=gemini-2.5-flash    # gemini-2.5-flash | gemini-2.5-pro | gemini-2.0-flash | gemini-3.1-flash-lite-preview
LLM_SECONDARY_MODEL=gemini-3.1-flash-lite-preview  # gemini-2.5-flash | gemini-2.5-pro | gemini-2.0-flash | gemini-3.1-flash-lite-preview

# Background Worker
WORKER_POLL_INTERVAL=2

# GitHub App (bot identity + automatic webhooks)
GITHUB_APP_ID=                   # numeric App ID shown in app settings
GITHUB_APP_PRIVATE_KEY_PATH=     # path inside the container, e.g. /app/secrets/tfg-validator.pem
GITHUB_APP_SLUG=                 # URL slug of the app, e.g. "rule-validator-tfg"
GITHUB_WEBHOOK_SECRET=           
APPROVAL_THRESHOLD=0.8           # score >= threshold → PR approved

# ngrok (tunnel for local webhook delivery)
NGROK_AUTHTOKEN=
